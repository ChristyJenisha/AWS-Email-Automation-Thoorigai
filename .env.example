# Local PostgreSQL used by Docker Compose
POSTGRES_DB=bill_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql://tracker:local-dev-only@db:5432/bill_tracker?schema=public

# Local app ports
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
APPROVAL_APP_URL=http://localhost:3000

# App secrets: replace for deployed environments; never commit real values
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_SIGNING_SECRET=replace-with-a-different-long-random-secret
OTP_TTL_SECONDS=600

# Email Delivery Modes:
# ---------------------
# Mode 1: Local Simulation (Default - No setup needed)
# Leave AWS_SES_FROM and SMTP_USER empty. The verification code is automatically
# displayed directly in the UI with a 1-click "✨ Auto-Fill & Verify" button.
AWS_REGION=ap-south-1
AWS_SES_FROM=

# Mode 2: Gmail SMTP (Send real emails via Google App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# GMAIL_USER=your-account@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
# SMTP_FROM=your-account@gmail.com

# Mode 3: AWS SES (Send real emails via Amazon Simple Email Service)
# AWS_REGION=ap-south-1
# AWS_SES_FROM=your-verified-ses-email@domain.com
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# AWS S3 (optional, proof uploads stored locally when blank)
S3_BUCKET=
