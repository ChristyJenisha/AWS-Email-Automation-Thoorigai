# Local PostgreSQL used by Docker Compose
POSTGRES_DB=bill_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql://tracker:local-dev-only@db:5432/bill_tracker?schema=public

# Local app ports
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# App secrets: replace for deployed environments; never commit real values
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_SIGNING_SECRET=replace-with-a-different-long-random-secret
OTP_TTL_SECONDS=600

# Email delivery (SES is active when AWS_SES_FROM is set; otherwise the API simulates local delivery)
AWS_REGION=ap-south-1
AWS_SES_FROM=notifications@your-domain.example

# AWS S3 (optional locally; use an AWS profile, never static keys in this file)
S3_BUCKET=