# Local PostgreSQL used by Docker Compose
POSTGRES_DB=bill_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql://tracker:local-dev-only@db:5432/bill_tracker?schema=public

# Local app ports
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
APPROVAL_APP_URL=http://localhost:3000

# App secrets: replace for deployed environments; never commit real values
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_SIGNING_SECRET=replace-with-a-different-long-random-secret
OTP_TTL_SECONDS=600

# Local development: leave AWS_SES_FROM blank to simulate email delivery.
# Set it only when intentionally testing with AWS SES.
AWS_REGION=ap-south-1
AWS_SES_FROM=

# AWS S3 is disabled locally when S3_BUCKET is blank.
# Set it only when intentionally testing with AWS S3 and an AWS profile.
S3_BUCKET=
