# ==============================================================================
# CollectFlow Environment Configuration Template (.env.example)
# DO NOT commit real secrets or production passwords to source control.
# ==============================================================================

# Database Connection (PostgreSQL)
POSTGRES_DB=bill_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=local-dev-only-change-in-production
DATABASE_URL=postgresql://tracker:local-dev-only-change-in-production@localhost:5432/bill_tracker?schema=public

# Application Ports & Endpoints
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
APPROVAL_APP_URL=https://collectflow-app.pages.dev

# Security & Authentication (Required: 32+ characters minimum)
JWT_SECRET=replace-with-a-random-jwt-secret-at-least-32-chars-long
TOKEN_SIGNING_SECRET=replace-with-a-different-random-signing-secret-32-chars
OTP_TTL_SECONDS=600

# CORS & Development Origins (Comma-separated)
CORS_ORIGINS=https://collectflow-app.pages.dev,https://thoorigaibilltracker.com,http://localhost:3000
ALLOWED_DEV_ORIGINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# Demo Mode Guard (Must be false in production)
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Bootstrap Administrator (Used when DEMO_MODE=false)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=System Administrator
ADMIN_ORG_ID=demo-org

# AWS SES & SNS Integration (Optional - falls back to simulation mode)
AWS_REGION=ap-south-1
AWS_SES_FROM=
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:ses-events

# SMTP Alternative (Gmail App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-char-google-app-password
# SMTP_FROM=your-account@gmail.com

# AWS S3 Storage for Proof Documents (Optional - falls back to local storage)
S3_BUCKET=
